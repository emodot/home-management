# Local secrets for `supabase start` / `supabase functions serve`. Copy to supabase/functions/.env.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the runtime automatically.
APP_URL=http://localhost:5173
# Leave RESEND_API_KEY empty locally to print emails (with their links) to the function logs.
RESEND_API_KEY=
EMAIL_FROM=Home <onboarding@resend.dev>
